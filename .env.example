# Copy this file to .env and fill in your own values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- AI / API keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# --- Jarvis voice assistant (optional) ---
JARVIS_EMAIL=
JARVIS_EMAIL_PASSWORD=
JARVIS_EMAIL_TO=
JARVIS_WHATSAPP_TO=
JARVIS_NOTEPAD_PATH=notepad.exe
JARVIS_MOVIE_PATH=
